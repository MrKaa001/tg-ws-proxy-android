# Release signing config — copy to keystore.properties (gitignored) and fill in.
# The keystore (*.jks) and the real keystore.properties never go into git.
#
# Generate a keystore once:
#   keytool -genkeypair -v -keystore tg-ws-proxy-release.jks -alias tgwsproxy \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the project root (rootProject.projectDir).
storeFile=tg-ws-proxy-release.jks
storePassword=CHANGE_ME
keyAlias=tgwsproxy
keyPassword=CHANGE_ME
